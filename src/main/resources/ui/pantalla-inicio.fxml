<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.simuladorinversiones.ui.ControladorPantallaInicio"
      styleClass="pantalla-inicio" spacing="24">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <VBox styleClass="tarjeta" spacing="14" HBox.hgrow="ALWAYS" maxWidth="380">
        <Label text="Nueva sesión de inversión" styleClass="titulo-tarjeta"/>
        <Label text="Fecha de inicio (desde 1900)"/>
        <DatePicker fx:id="selectorFechaInicio" maxWidth="Infinity"/>
        <Label text="Capital inicial"/>
        <TextField fx:id="campoCapitalInicial" promptText="Ej: 10000"/>
        <Label fx:id="etiquetaErrorNuevaSesion" styleClass="texto-error" wrapText="true"/>
        <Button text="Comenzar simulación" styleClass="boton-primario" onAction="#alComenzarNuevaSesion"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="14" HBox.hgrow="ALWAYS">
        <Label text="Retomar una sesión guardada" styleClass="titulo-tarjeta"/>
        <TableView fx:id="tablaSesionesGuardadas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="columnaFechaInicio" text="Inicio" prefWidth="110"/>
                <TableColumn fx:id="columnaFechaActual" text="Fecha actual" prefWidth="110"/>
                <TableColumn fx:id="columnaSaldo" text="Saldo" prefWidth="120"/>
                <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
        <Button fx:id="botonRetomar" text="Retomar sesión seleccionada" styleClass="boton-primario"
                onAction="#alRetomarSesion"/>
    </VBox>
</HBox>
