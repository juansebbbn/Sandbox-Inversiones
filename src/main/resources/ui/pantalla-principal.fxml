<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.simuladorinversiones.ui.ControladorPantallaPrincipal"
      spacing="12" alignment="CENTER">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Simulador de Inversiones" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="etiquetaEstadoConexion" text="Verificando conexión con la base de datos..."/>
</VBox>
