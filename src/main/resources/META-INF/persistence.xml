<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="simuladorInversiones" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.simuladorinversiones.core.entidades.Usuario</class>
        <class>com.simuladorinversiones.core.entidades.SesionInversion</class>
        <class>com.simuladorinversiones.core.entidades.Activo</class>
        <class>com.simuladorinversiones.core.entidades.HistorialPrecio</class>
        <class>com.simuladorinversiones.core.entidades.CarteraUsuario</class>
        <class>com.simuladorinversiones.core.entidades.PosicionCartera</class>
        <class>com.simuladorinversiones.core.entidades.Transaccion</class>
        <class>com.simuladorinversiones.core.entidades.Noticia</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- La conexión real (URL, usuario, password) la arma ConfiguracionBaseDatos
                 en tiempo de ejecución, para poder leerla de variables de entorno.
                 Estos valores son solo el fallback para desarrollo local. -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/simulador_inversiones"/>
            <property name="jakarta.persistence.jdbc.user" value="simulador"/>
            <property name="jakarta.persistence.jdbc.password" value="simulador"/>

            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
